# Copy to .env.local and fill in. On Vercel, add the same names under Project Settings > Environment Variables.

# Supabase (Project Settings > API). Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenTimestamps Bitcoin anchoring — no server or wallet needed.
# Only SUPABASE_SERVICE_ROLE_KEY is required (already set for the cron). If it is set, Merkle roots
# are stamped on Bitcoin via free public OTS calendars and proofs are stored in the ots_proofs table.
# Leave SUPABASE_SERVICE_ROLE_KEY unset to run in simulated mode (safe for local dev).

# Real fixtures and results for the admin page (free key: https://www.football-data.org/client/register).
FOOTBALL_DATA_KEY=

# Reveal escrow: lets players reveal sealed moves from any device they sign in on. 32 random bytes, base64:
#   openssl rand -base64 32
SEAL_ESCROW_KEY=

# Auto fixture pipeline (/api/cron). The cron hits GET /api/cron?token=<secret> every 30 minutes.
CRON_SECRET=
# Supabase service role key (server-side only, never expose to browser). Used by the cron to write fixtures.
SUPABASE_SERVICE_ROLE_KEY=

# Push notifications (VAPID keys). Generate a key pair:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# (Optional) 1-Click Automated Cloud Payouts via GitHub Actions
# If set on Vercel, the "Run automated payouts" button in /admin triggers an ephemeral
# GitHub Actions runner (.github/workflows/payouts.yml) to sync & send shielded ZEC payouts.
# GITHUB_REPO=username/called-it
# GITHUB_PAT=ghp_...
