# Copy to .env.local and fill in. On Vercel, add the same names under Project Settings > Environment Variables.

# Supabase (Project Settings > API). Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Zcash testnet anchor service (services/anchor). Leave empty to stay in simulated mode.
ANCHOR_URL=
ANCHOR_TOKEN=
