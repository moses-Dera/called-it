# Copy to .env.local and fill in. On Vercel, add the same names under Project Settings > Environment Variables.

# Supabase (Project Settings > API). Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Zcash testnet anchor service (services/anchor). Leave empty to stay in simulated mode.
ANCHOR_URL=
ANCHOR_TOKEN=

# Real fixtures and results for the admin page (free key: https://www.football-data.org/client/register).
FOOTBALL_DATA_KEY=7e8f5ca3bf564cf7b1f2794469250a8a

# Reveal escrow: lets players reveal sealed moves from any device they sign in on. 32 random bytes, base64:
#   openssl rand -base64 32
SEAL_ESCROW_KEY=
